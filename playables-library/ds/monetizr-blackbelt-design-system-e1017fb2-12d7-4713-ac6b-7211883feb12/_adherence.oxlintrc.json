{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/**",
              "components/buttons/**",
              "components/cards/**",
              "components/content/**",
              "components/controls/**",
              "components/data/**",
              "components/media/**",
              "resources-mockups/**",
              "ui_kits/Resources/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Lato))/i]",
        "message": "Font not provided by the design system. Available: Lato."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|icon|children|style|key|ref|className|style|children)$/]",
        "message": "<ArrowLink> doesn't accept that prop. Declared props: href, icon, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:initials|logoSrc|icon|benchmark|href|style|key|ref|className|style|children)$/]",
        "message": "<BrandCard> doesn't accept that prop. Declared props: initials, logoSrc, icon, benchmark, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|href|icon|children|onClick|disabled|type|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, href, icon, children, onClick, disabled, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:tag|tagIcon|title|hook|children|href|linkLabel|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: tag, tagIcon, title, hook, children, href, linkLabel, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|highlight|key|ref|className|style|children)$/]",
        "message": "<DataTableRow> doesn't accept that prop. Declared props: label, value, highlight."
      },
      {
        "selector": "JSXOpeningElement[name.name='DropdownField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|placeholder|options|value|defaultValue|onChange|style|key|ref|className|style|children)$/]",
        "message": "<DropdownField> doesn't accept that prop. Declared props: label, placeholder, options, value, defaultValue, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmailInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|placeholder|value|defaultValue|helperText|errorText|required|onChange|onValidChange|style|key|ref|className|style|children)$/]",
        "message": "<EmailInput> doesn't accept that prop. Declared props: label, hint, placeholder, value, defaultValue, helperText, errorText, required, onChange, onValidChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|children|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: icon, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterDropdown'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|options|onSelect|style|key|ref|className|style|children)$/]",
        "message": "<FilterDropdown> doesn't accept that prop. Declared props: label, icon, options, onSelect, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HelpNote'] > JSXAttribute > JSXIdentifier[name!=/^(?:helperText|linkLabel|body|defaultOpen|style|key|ref|className|style|children)$/]",
        "message": "<HelpNote> doesn't accept that prop. Declared props: helperText, linkLabel, body, defaultOpen, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NumberBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|size|fontSize|fill|color|border|weight|style|key|ref|className|style|children)$/]",
        "message": "<NumberBadge> doesn't accept that prop. Declared props: children, size, fontSize, fill, color, border, weight, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PanelCta'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|icon|key|ref|className|style|children)$/]",
        "message": "<PanelCta> doesn't accept that prop. Declared props: label, href, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhoneFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|caption|number|style|key|ref|className|style|children)$/]",
        "message": "<PhoneFrame> doesn't accept that prop. Declared props: children, caption, number, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|sub|tight|id|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: children, sub, tight, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slider'] > JSXAttribute > JSXIdentifier[name!=/^(?:min|max|step|defaultValue|value|onChange|marks|valueLabelDisplay|decimals|grouping|valuePrefix|valueSuffix|minLabel|maxLabel|ariaLabel|style|key|ref|className|style|children)$/]",
        "message": "<Slider> doesn't accept that prop. Declared props: min, max, step, defaultValue, value, onChange, marks, valueLabelDisplay, decimals, grouping, valuePrefix, valueSuffix, minLabel, maxLabel, ariaLabel, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slider'] > JSXAttribute[name.name='valueLabelDisplay'] > Literal[value!=/^(?:off|auto|on)$/]",
        "message": "<Slider> valueLabelDisplay must be one of 'off' | 'auto' | 'on'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:num|label|key|ref|className|style|children)$/]",
        "message": "<StatItem> doesn't accept that prop. Declared props: num, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|onRemove|onClick|selected|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, tone, onRemove, onClick, selected, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:muted|gold)$/]",
        "message": "<Tag> tone must be one of 'muted' | 'gold'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
